engine-strict=true
auto-install-peers=true
strict-peer-dependencies=false

# React Native / Metro kurang ramah terhadap symlink pnpm.
# Konfigurasi Metro di apps/mobile-* sudah mengaktifkan unstable_enableSymlinks.
# Jika masih muncul galat resolusi modul saat build mobile, ganti baris di bawah
# menjadi aktif — pnpm akan berperilaku seperti npm (node_modules datar):
# node-linker=hoisted
