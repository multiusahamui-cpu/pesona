engine-strict=true
auto-install-peers=true
strict-peer-dependencies=false

# ------------------------------------------------------------------
# Ketahanan jaringan
# ------------------------------------------------------------------
# Koneksi ke registry.npmjs.org dari Indonesia kerap ECONNRESET pada
# tarball besar (react-native ~24 MB, next ~31 MB). Default pnpm
# mengunduh 16 paket paralel — pada tautan tidak stabil itu justru
# memicu reset beruntun. Turunkan paralelisme, naikkan batas waktu.
network-concurrency=4
child-concurrency=2
fetch-retries=5
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=120000
fetch-timeout=300000

# ------------------------------------------------------------------
# React Native / Metro
# ------------------------------------------------------------------
# Metro kurang ramah terhadap symlink pnpm. Konfigurasi Metro di
# apps/mobile-* sudah mengaktifkan unstable_enableSymlinks.
# Jika masih muncul galat resolusi modul saat build mobile,
# aktifkan baris di bawah — pnpm berperilaku seperti npm:
# node-linker=hoisted
