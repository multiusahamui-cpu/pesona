# syntax=docker/dockerfile:1
# Build multi-stage untuk @pesona/dispatch

FROM node:22-alpine AS base
RUN corepack enable
WORKDIR /app

FROM base AS deps
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json .npmrc ./
COPY packages/ ./packages/
COPY services/dispatch/package.json ./services/dispatch/
RUN pnpm install --frozen-lockfile --filter @pesona/dispatch...

FROM base AS build
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/packages ./packages
COPY . .
RUN pnpm turbo run build --filter=@pesona/dispatch

FROM base AS runtime
ENV NODE_ENV=production
RUN addgroup -S pesona && adduser -S pesona -G pesona
COPY --from=build --chown=pesona:pesona /app/node_modules ./node_modules
COPY --from=build --chown=pesona:pesona /app/packages ./packages
COPY --from=build --chown=pesona:pesona /app/services/dispatch ./services/dispatch
USER pesona
WORKDIR /app/services/dispatch
EXPOSE 5000
CMD ["node", "dist/index.js"]
