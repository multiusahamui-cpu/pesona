{
  "name": "@pesona/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Sumber kebenaran tipe: skema zod, lalu OpenAPI di-generate darinya (ADR: zod-first).",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "gen:openapi": "tsx scripts/gen-openapi.ts",
    "test": "vitest run",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@pesona/config": "workspace:*",
    "eslint": "^9.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "zod-to-json-schema": "^3.24.1"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  }
}
