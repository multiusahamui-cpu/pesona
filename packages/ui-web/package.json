{
  "name": "@pesona/ui-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Design system web Pesona. Wajib mengekspor komponen navigasi & konfirmasi transaksi (pagar ADR-007).",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@pesona/contracts": "workspace:*",
    "react": "^19.2.3"
  },
  "devDependencies": {
    "@pesona/config": "workspace:*",
    "@types/react": "~19.2.0",
    "eslint": "^9.17.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  }
}
