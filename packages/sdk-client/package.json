{
  "name": "@pesona/sdk-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Client API tipe-aman, tipe diturunkan dari @pesona/contracts lewat inferensi.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@pesona/contracts": "workspace:*",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@pesona/config": "workspace:*",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  }
}
