# ============================================================
# Pesona SuperApp — variabel lingkungan DEV
# ------------------------------------------------------------
# Berkas ini HANYA untuk pengembangan lokal.
# Di produksi TIDAK ADA berkas .env sama sekali (lihat ADR-005):
# rahasia dipasok lewat External Secrets Operator + KMS/Vault.
#
# Salin ke .env lalu isi. .env tidak pernah di-commit.
# ============================================================

NODE_ENV=development

# --- Data bersama (dipakai lintas service) -------------------
DATABASE_URL=postgresql://pesona:pesona@localhost:5432/pesona_dev
REDIS_URL=redis://localhost:6379

# --- core-api ------------------------------------------------
PORT=5000
SESSION_SECRET=ganti-dengan-nilai-acak-panjang

# --- service internal ----------------------------------------
DISPATCH_URL=http://localhost:5001
LOCATION_URL=http://localhost:5002
NOTIFICATION_URL=http://localhost:5003

# --- Rahasia spesifik: taruh di services/<x>/.env.local ------
# Jangan menaruh kunci payment gateway atau FCM di berkas ini.
